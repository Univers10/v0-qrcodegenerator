# URL publique de l'application (utilisée dans les QR codes dynamiques : {URL}/r/{code})
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données libSQL / SQLite
# - Local : fichier SQLite
# - Production : base Turso, ex. libsql://qr-creator-<org>.turso.io
#   (l'intégration Turso du Vercel Marketplace fournit TURSO_DATABASE_URL / TURSO_AUTH_TOKEN,
#    également reconnues)
DATABASE_URL=file:data/qr-creator.db
DATABASE_AUTH_TOKEN=

# Better Auth — générez une valeur avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Facultatif sur Vercel : déduite de l'URL de production si absente
BETTER_AUTH_URL=http://localhost:3000
